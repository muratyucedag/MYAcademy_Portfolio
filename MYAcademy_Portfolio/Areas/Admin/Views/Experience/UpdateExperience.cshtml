@model MYAcademy_Portfolio.Entities.Experience
@{
    ViewData["Title"] = "Deneyim Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var workTypes = new List<string> { "Tam Zamanlı", "Yarı Zamanlı", "Staj", "Freelance", "Uzaktan", "Hibrit" };
    // Kayıtlı değer listede yoksa kaybolmasın diye ekle
    if (!string.IsNullOrWhiteSpace(Model?.WorkType) && !workTypes.Contains(Model.WorkType))
    {
        workTypes.Insert(0, Model.WorkType);
    }
}

@section Styles {
    <style>
        .form-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
        }

        .form-card-header {
            padding: 20px 26px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .form-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--pastel-purple);
            color: var(--primary-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .form-card-body {
            padding: 26px;
        }

        .form-card-footer {
            padding: 16px 26px;
            border-top: 1px solid var(--border-color);
            background: #FAFBFE;
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .form-label {
            font-size: 0.83rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

            .form-label .req {
                color: #c0342b;
            }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #DCE1ED;
            padding: 9px 13px;
            font-size: 0.88rem;
        }

        .input-icon-wrap {
            position: relative;
        }

            .input-icon-wrap i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-secondary);
                pointer-events: none;
            }

            .input-icon-wrap .form-control,
            .input-icon-wrap .form-select {
                padding-left: 38px;
            }

        .status-box {
            border: 1px solid #DCE1ED;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .form-switch .form-check-input {
            width: 2.6em;
            height: 1.35em;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: var(--primary-accent);
            border-color: var(--primary-accent);
        }

        .btn-accent {
            background: var(--primary-accent);
            border: 1px solid var(--primary-accent);
            color: #fff;
            border-radius: 12px;
            font-weight: 600;
            padding: 9px 20px;
            box-shadow: 0 4px 12px rgba(130, 118, 217, 0.25);
        }

            .btn-accent:hover {
                background: var(--primary-accent-hover);
                color: #fff;
            }

        .btn-soft {
            background: #fff;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 12px;
            font-weight: 500;
            padding: 9px 18px;
        }

            .btn-soft:hover {
                background: #F8F9FD;
                color: var(--primary-accent);
            }

        .field-validation-error {
            font-size: 0.78rem;
            color: #c0342b;
        }
    </style>
}

<div class="form-card">
    <form asp-area="Admin" asp-action="UpdateExperience" method="post">
        <input type="hidden" asp-for="ExperienceId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-briefcase"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Deneyimi Güncelle</h5>
                <small class="text-secondary">Mevcut deneyim bilgilerini düzenleyip kaydedin.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-4">
                <!-- Pozisyon -->
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Pozisyon / Ünvan <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person-badge"></i>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Senior Software Engineer" required />
                    </div>
                    <span asp-validation-for="Title"></span>
                </div>

                <!-- Şirket -->
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Şirket Adı <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-building"></i>
                        <input asp-for="CompanyName" class="form-control" placeholder="Örn: NovaTech Solutions" required />
                    </div>
                    <span asp-validation-for="CompanyName"></span>
                </div>

                <!-- Alt Başlık -->
                <div class="col-md-6">
                    <label asp-for="SideTitle" class="form-label">Alt Başlık</label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-geo-alt"></i>
                        <input asp-for="SideTitle" class="form-control" placeholder="Örn: İstanbul / Hibrit" />
                    </div>
                    <span asp-validation-for="SideTitle"></span>
                </div>

                <!-- Süre -->
                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label">Süre / Tarih Aralığı <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-calendar3"></i>
                        <input asp-for="Duration" class="form-control" placeholder="Örn: Ocak 2025 - Devam Ediyor" required />
                    </div>
                    <span asp-validation-for="Duration"></span>
                </div>

                <!-- Çalışma Tipi -->
                <div class="col-md-6">
                    <label asp-for="WorkType" class="form-label">Çalışma Tipi <span class="req">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-clock-history"></i>
                        <select asp-for="WorkType" class="form-select" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var type in workTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="WorkType"></span>
                </div>

                <!-- Durum -->
                <div class="col-md-6">
                    <label class="form-label">Durum</label>
                    <div class="status-box">
                        <div>
                            <div class="fw-semibold" style="font-size: 0.86rem;">Halen burada çalışıyorum</div>
                            <small class="text-secondary">Aktif ise portfolyoda "Devam Ediyor" olarak görünür.</small>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        </div>
                    </div>
                </div>

                <!-- Açıklama -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Açıklama <span class="req">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5"
                              placeholder="Bu pozisyonda üstlendiğiniz görevleri ve sorumlulukları yazın..." required></textarea>
                    <span asp-validation-for="Description"></span>
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <a asp-area="Admin" asp-action="Index" class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i> Vazgeç
            </a>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>

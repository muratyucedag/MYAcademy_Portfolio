@model List<MYAcademy_Portfolio.Entities.Experience>

@{
    ViewData["Title"] = "ExperienceList";
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br /><br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Alt Başlık</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.ExperienceId</td>
                <td>@item.Title</td>
                <td>@item.SideTitle</td>
                <td>@item.Duration</td>
                <td>@item.IsActive</td>
                <td>Sil</td>
                <td>Güncelle</td>
            </tr>
        }
    </table>
</div>

